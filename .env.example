# Railway Postgres connection string (pooled or direct)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Public site URL (no trailing slash)
SITE_URL=http://localhost:3000

# OpenAI (ingestion worker) — optional until sources are connected
AI_API_KEY=

# Temporary admin gate (replace before public production)
ADMIN_PASSWORD=

# Worker tuning
WORKER_POLL_MS=5000
